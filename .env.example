GEMINI_API_KEY=your_gemini_api_key_here
# Default high-volume card generation / Batch model.
GEMINI_MODEL=gemini-2.5-flash-lite
# Import Material text extraction / Smart Vocabulary / Smart Grammar.
GEMINI_IMPORT_MODEL=gemini-2.5-flash
# Screenshots, tables, book photos. Falls back to GEMINI_IMPORT_MODEL then GEMINI_MODEL.
GEMINI_MULTIMODAL_MODEL=gemini-2.5-flash
# Review/Fix Cards / conversation feedback. Falls back to GEMINI_IMPORT_MODEL then GEMINI_MODEL.
GEMINI_REVIEW_MODEL=gemini-2.5-flash

# Optional second provider. Add this key to make OpenAI selectable in the app.
OPENAI_API_KEY=your_openai_api_key_here
# Default high-volume card generation / Batch model.
OPENAI_MODEL=gpt-5.6-luna
# Import Material text extraction / Smart Vocabulary / Smart Grammar.
OPENAI_IMPORT_MODEL=gpt-5.6-terra
# Screenshots, tables, book photos. Falls back to OPENAI_IMPORT_MODEL then OPENAI_MODEL.
OPENAI_MULTIMODAL_MODEL=gpt-5.6-terra
# Review/Fix Cards / difficult repairs / conversation feedback. Falls back to OPENAI_IMPORT_MODEL then OPENAI_MODEL.
OPENAI_REVIEW_MODEL=gpt-5.6-terra
# Optional manual premium model; the app does not use this automatically.
OPENAI_PREMIUM_MODEL=gpt-5.6-sol

# Optional local/free LLM provider through Ollama. No API key required.
# Install Ollama, pull a chat model, then set OLLAMA_MODEL.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

ANKI_CONNECT_URL=http://localhost:8765
ANKI_DECK_NAME=AI Vocabulary
DEFAULT_TARGET_LANGUAGE=English

# Optional Claude provider. Add this key to make Claude selectable in the app.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Claude uses Haiku/Sonnet/Opus naming, not Flash.
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_IMPORT_MODEL=claude-sonnet-4-20250514
CLAUDE_REVIEW_MODEL=claude-sonnet-4-20250514
CLAUDE_PREMIUM_MODEL=claude-opus-4-1

# Optional text-to-speech providers
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Free/local Piper TTS with standalone piper.exe.
# Example Windows paths after your local test:
TTS_PROVIDER=piper
PIPER_EXE_PATH=C:\tools\piper\piper.exe
PIPER_VOICE_EN=C:\tools\piper\voices\en_US-lessac-medium.onnx
PIPER_VOICE_ES=
PIPER_VOICE_PL=
# Backwards-compatible single Piper voice path. Leave empty if using PIPER_VOICE_EN/ES/PL.
PIPER_MODEL_PATH=
AUDIO_CACHE_DIR=.audio_cache

# Optional cloud OCR provider for OCR / Import → Mistral OCR auto candidates
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Optional local speech-to-text for Conversation Practice
# STT only fills the answer textbox; you can edit the transcript before sending.
# Leave it configured for later testing on a computer with a microphone.
STT_PROVIDER=local_whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=
# Conversation Practice overrides this with the selected conversation language when possible.

# Optional LLMOps / LangSmith tracing
# Disabled by default. Turn on when you want traces for portfolio/debugging.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-anki-language-assistant
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Keep ON if you do not want full pasted OCR/book text in external traces.
LANGSMITH_REDACT_INPUTS=true

# Optional LLMOps estimated-cost tracking
# Leave blank to track tokens without local cost estimates. Values are provider prices per 1M tokens.
LLMOPS_COST_CURRENCY=EUR
OPENAI_INPUT_COST_PER_1M_TOKENS=
OPENAI_OUTPUT_COST_PER_1M_TOKENS=
GEMINI_INPUT_COST_PER_1M_TOKENS=
GEMINI_OUTPUT_COST_PER_1M_TOKENS=
CLAUDE_INPUT_COST_PER_1M_TOKENS=
CLAUDE_OUTPUT_COST_PER_1M_TOKENS=

# Optional TTS estimated-cost tracking. Values are provider prices per 1000 characters.
ELEVENLABS_COST_PER_1000_CHARS=
OPENAI_TTS_COST_PER_1000_CHARS=
GEMINI_TTS_COST_PER_1000_CHARS=
